# Health Copilot - Backend Environment Configuration Example
# Copy this file to .env and configure local values as needed.
# NEVER commit the real .env file or real API keys to version control.

# Server Configuration
PORT=5000
NODE_ENV=development

# Storage & Database Configuration
DATABASE_PATH=./db/health_copilot.db
UPLOAD_DIR=./uploads

# Client CORS Configuration
CLIENT_ORIGIN=http://127.0.0.1:5500

# AI Provider Configuration (Future Integration)
# Options: "local" (e.g., Ollama / Llama 3) | "gemini" | "huggingface"
AI_PROVIDER=local
AI_MODEL_NAME=llama3
AI_API_KEY=your_api_key_here_if_using_cloud_provider
